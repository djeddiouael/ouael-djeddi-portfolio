# ---------------------------------------------------------------------------
# Public site URL (canonical tags, Open Graph, sitemap.xml, robots.txt, JSON-LD)
# Set this to your custom domain in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://ouael-djeddi-portfolio.vercel.app

# ---------------------------------------------------------------------------
# Privacy-friendly analytics (optional — leave empty to disable)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ---------------------------------------------------------------------------
# Contact form delivery via Resend (optional)
# Without these values the form never fakes success; it offers a prefilled
# mailto fallback instead.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=djeddi.ouael@gmail.com
# Must be a sender verified in your Resend account (onboarding@resend.dev
# only works for the account owner's own inbox).
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
